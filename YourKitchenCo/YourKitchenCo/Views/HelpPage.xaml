<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourKitchenCo.Views.HelpPage"
             Title="Help &amp; Support"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="*, Auto" Padding="24">

        <!-- Main Scrollable Support Actions -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="6" Margin="4,5,0,5">
                    <Label Text="Need Assistance?" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Text="Our dedicated operations and support desk are standing by to help you." 
                           FontSize="14" 
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>

                <!-- Contact Support Info Card Frame -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#252525}"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource CardBgDark}}"
                        Padding="20">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Label Text="✉️" 
                               FontSize="32" 
                               HorizontalOptions="Center" />
                        <Label Text="Direct Email Support" 
                               FontAttributes="Bold" 
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="{Binding SupportEmail}" 
                               FontAttributes="Bold" 
                               FontSize="15"
                               HorizontalOptions="Center" 
                               TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Help Advisory Notice Box -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#EFE9DC, Dark=#242426}"
                        Padding="16"
                        Margin="2,0">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="💡" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="For immediate order assistance, check active status windows." 
                               FontSize="13" 
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#4E4E4E, Dark=#A1A1AA}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Cancellation & Holiday Policy -->
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#252525}"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource CardBgDark}}"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewCancellationPolicyCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="📄" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Cancellation &amp; Holiday Policy" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" Margin="10,0,0,0"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Grid.Column="2" Text="›" FontSize="18" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed Footer Frame Elements -->
        <Label Grid.Row="1"
               Text="{Binding AppVersion, StringFormat='Version: {0}'}" 
               FontSize="12" 
               HorizontalOptions="Center" 
               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
               Margin="0,15,0,5" />
    </Grid>
</ContentPage>