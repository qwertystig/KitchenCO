<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:YourKitchenCo.ViewModel"
             x:Class="YourKitchenCo.Views.TaxInvoicePage"
             x:DataType="vm:TaxInvoiceViewModel"
             Title="Invoice"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Invoice" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                <Label Text="{Binding Order.TaxInvoiceNumber}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </VerticalStackLayout>

            <!-- Supplier & Customer Details -->
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="SUPPLIER DETAILS" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="Your Kitchen Co. (Pty) Ltd" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="VAT Reg No: 4910298412" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Text="Corporate Culinary Hub, Sandton, 2196" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                    <VerticalStackLayout Spacing="2">
                        <Label Text="CUSTOMER &amp; DROP-OFF" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="{Binding Order.CustomerName}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="{Binding Order.OrderNumber, StringFormat='Order #{0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Text="{Binding CustomerCompanyName}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="{Binding CustomerLocationName}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Text="{Binding Order.DeliveryFloor}" FontSize="12" IsVisible="{Binding Order.DeliveryFloor, Converter={StaticResource IsNotNullOrEmptyConverter}}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Text="{Binding Order.DeliveryDate, StringFormat='Scheduled Delivery: {0:dddd, dd MMM yyyy}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Line Items & Totals -->
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="LINE ITEMS" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="{Binding Order.ItemName}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding MealSubtotal, StringFormat='R {0:F2}'}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Meal Subtotal" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding MealSubtotal, StringFormat='R {0:F2}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding Order.SubsidyAmount, Converter={StaticResource GreaterThanZeroConverter}}">
                        <Label Grid.Column="0" Text="Company Subsidy" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding Order.SubsidyAmount, StringFormat='-R {0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding Order.DiscountAmount, Converter={StaticResource GreaterThanZeroConverter}}">
                        <Label Grid.Column="0" Text="Corporate Discount" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding Order.DiscountAmount, StringFormat='-R {0:F2}'}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Delivery Fee" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding Order.DeliveryFee, StringFormat='R {0:F2}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Total Paid (ZAR)" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding Order.TotalAmount, StringFormat='R {0:F2}'}" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>

                    <Label Text="VAT: Not applicable — zero-rated corporate catering." FontSize="10" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
<Button Grid.Column="0" Text="Download PDF"
                    Command="{Binding DownloadInvoicePdfCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48" />
<Button Grid.Column="1" Text="Share as Text"
                    Command="{Binding ShareInvoiceCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48" />
</Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
