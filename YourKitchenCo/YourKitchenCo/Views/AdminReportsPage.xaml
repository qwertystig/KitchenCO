<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:YourKitchenCo.ViewModel"
             xmlns:models="clr-namespace:YourKitchenCo.Models"
             xmlns:views="clr-namespace:YourKitchenCo.Views"
             x:Class="YourKitchenCo.Views.AdminReportsPage"
             Title="Reports &amp; Analytics"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="Auto, *">
        <views:AdminNavStrip Grid.Row="0" ActiveRoute="adminreports" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Filters -->
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Picker Grid.Column="0"
                            ItemsSource="{Binding TimeframeOptions}"
                            SelectedItem="{Binding SelectedTimeframe}"
                            Title="Select Range" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding CompanyFilterOptions}"
                            SelectedItem="{Binding SelectedCompanyFilter}"
                            Title="Filter Company" />
                </Grid>

                <Picker ItemsSource="{Binding CategoryFilterOptions}"
                        SelectedItem="{Binding SelectedCategoryFilter}"
                        Title="Filter Category" />

                <!-- Custom date range, shown only when "Custom Range" is picked -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" IsVisible="{Binding IsCustomRangeVisible}">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="From" FontSize="11" TextColor="#888888" />
                        <DatePicker Date="{Binding CustomStartDate}" Format="dd MMM yyyy" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="To" FontSize="11" TextColor="#888888" />
                        <DatePicker Date="{Binding CustomEndDate}" Format="dd MMM yyyy" />
                    </VerticalStackLayout>
                </Grid>

                <Button Text="Export Report"
                        Command="{Binding ExportReportCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                        TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="42" />
            </VerticalStackLayout>

            <!-- KPI Metric Summary Cards -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Grid.Row="0" Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        Padding="16"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Total Sales" FontSize="11" TextColor="#888888" FontAttributes="Bold" />
                        <Label Text="{Binding TotalRevenue, StringFormat='R{0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        Padding="16"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Orders Completed" FontSize="11" TextColor="#888888" FontAttributes="Bold" />
                        <Label Text="{Binding TotalOrders}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        Padding="16"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Avg. Order Value" FontSize="11" TextColor="#888888" FontAttributes="Bold" />
                        <Label Text="{Binding AverageOrderValue, StringFormat='R{0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                        Padding="16"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Top Item" FontSize="11" TextColor="#888888" FontAttributes="Bold" />
                        <Label Text="{Binding TopSellingItem}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Revenue by Day/Week Bar Chart -->
            <Label Text="Revenue Over Time" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="12"
                    StrokeThickness="0">
                <GraphicsView Drawable="{Binding BarChart}" HeightRequest="200" />
            </Border>

            <!-- Revenue Share Pie/Donut Chart + Legend -->
            <Label Text="Revenue Share by Item" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                    Padding="12"
                    StrokeThickness="0">
                <Grid ColumnDefinitions="*, *">
                    <GraphicsView Grid.Column="0" Drawable="{Binding PieChart}" HeightRequest="180" WidthRequest="180" HorizontalOptions="Center" />

                    <CollectionView Grid.Column="1" ItemsSource="{Binding TopSellingItems}" VerticalOptions="Center">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="6" Margin="0,4">
                                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding SwatchColor}" />
                                    <Label Text="{Binding ItemName}" FontSize="11" LineBreakMode="TailTruncation" WidthRequest="130" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- Top Selling Items Breakdown -->
            <Label Text="Top Menu Performers" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <CollectionView ItemsSource="{Binding TopSellingItems}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                Padding="14"
                                Margin="0,0,0,10"
                                StrokeThickness="0">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="{Binding ItemName}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding UnitsSold, StringFormat='{0} sold'}" FontSize="12" TextColor="#888888" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding TotalRevenue, StringFormat='R{0:F2}'}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Disputed Orders — only shows when there's something to see -->
            <Label Text="Disputed Orders" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   IsVisible="{Binding HasDisputes}"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <CollectionView ItemsSource="{Binding DisputedOrders}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Order">
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                StrokeThickness="1"
                                Padding="14"
                                Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Grid.Column="0" Text="{Binding DisputeTicketRef}" FontAttributes="Bold" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                    <Border Grid.Column="1" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3" BackgroundColor="#1AF59E0B">
                                        <Label Text="{Binding DisputeStatus}" FontSize="10" FontAttributes="Bold" TextColor="#B45309" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding ItemName}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                <Label Text="{Binding DisputeReason}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                <Label Text="{Binding CustomerName, StringFormat='Reported by {0}'}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                                <Button Text="Update Status"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminReportsViewModel}}, Path=ResolveDisputeCommand}"
                                        CommandParameter="{Binding .}"
                                        FontSize="11"
                                        HeightRequest="34"
                                        HorizontalOptions="Start"
                                        Padding="14,0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
