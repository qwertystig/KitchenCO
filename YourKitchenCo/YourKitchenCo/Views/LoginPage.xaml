<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:YourKitchenCo.ViewModel"
             x:Class="YourKitchenCo.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <VerticalStackLayout Padding="30" VerticalOptions="Center" Spacing="20">

        <!-- Logo Frame Scaling -->
        <Image Source="{AppThemeBinding Light=yourkcolight.png, Dark=yourkcodark.png}"
               HeightRequest="350"
               HorizontalOptions="Center"
               Aspect="AspectFit"
               Margin="0,0,0,5" />

        <!-- Subtitle Context Header -->
        <Label Text="Sign in to continue" 
               FontSize="14" 
               HorizontalOptions="Center"
               Margin="0, -10, 0, 15"
               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

        <!-- Login Form Layout Container -->
        <VerticalStackLayout Spacing="14">

            <!-- Email Border Entry Element -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 12" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource CardBgDark}}"
                    HeightRequest="50">
                <Entry Placeholder="Email Address (e.g., alex@example.com)" 
                       Keyboard="Email"
                       Text="{Binding Email}"
                       BackgroundColor="Transparent"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       PlaceholderColor="#888888"
                       Margin="15,0"
                       VerticalOptions="Center" />
            </Border>

            <!-- Password Border Entry Element -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    StrokeShape="RoundRectangle 12" 
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource CardBgDark}}"
                    HeightRequest="50">
                <Entry Placeholder="Password (e.g., ••••••••)" 
                       IsPassword="True"
                       Text="{Binding Password}"
                       BackgroundColor="Transparent"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                       PlaceholderColor="#888888"
                       Margin="15,0"
                       VerticalOptions="Center" />
            </Border>

            <!-- Row Matrix for Remember Me and Forgot Password Action States -->
            <Grid ColumnDefinitions="*, *" Margin="2,4">

                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Grid.Column="0">
                    <CheckBox IsChecked="{Binding IsRememberMe}" 
                              Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                    <Label Text="Remember me" 
                           VerticalOptions="Center"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </HorizontalStackLayout>

                <Button Text="Forgot Password?" 
                        Command="{Binding ForgotPasswordCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        FontSize="13"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Grid.Column="1"
                        Padding="0"/>
            </Grid>
        </VerticalStackLayout>

        <!-- Secure Form Execution Trigger Section -->
        <VerticalStackLayout Spacing="16" Margin="0,10,0,0">

            <!-- Secure Icon Login Capsule Execution Button -->
            <Button Text="🔐  SECURE LOGIN"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="15"
                    HeightRequest="50"
                    CornerRadius="25">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#20000000, Dark=#40000000}" Offset="0,4" Radius="6" Opacity="0.7"/>
                </Button.Shadow>
            </Button>

            <!-- Inline Navigation Context Layout -->
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Don't have an account?" 
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                <Button Text="Sign Up" 
                        Command="{Binding RegisterCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        FontAttributes="Bold"
                        Padding="0"
                        VerticalOptions="Center"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>

    </VerticalStackLayout>
</ContentPage>