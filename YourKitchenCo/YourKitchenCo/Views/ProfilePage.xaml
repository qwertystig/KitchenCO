<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourKitchenCo.Views.ProfilePage"
             Title="My Profile"
             BackgroundColor="{AppThemeBinding Light={StaticResource Cream}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="24" HorizontalOptions="Fill">

            <!-- Interactive Layered Profile Avatar Section Container -->
            <Grid HorizontalOptions="Center" HeightRequest="110" WidthRequest="110" Margin="0,10,0,5">

                <!-- Perfectly Clipped Circular Profile Image Asset Frame -->
                <Border WidthRequest="100" 
                        HeightRequest="100"
                        StrokeThickness="2"
                        Stroke="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                        StrokeShape="RoundRectangle 50"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Image Source="user.png" 
                           Aspect="AspectFill" 
                           WidthRequest="100" 
                           HeightRequest="100" />
                </Border>

                <!-- Floating Interactive Camera Action Option Button Badge -->
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        WidthRequest="32"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,5,5">
                    <Border.GestureRecognizers>
                        <!-- Routes directly to change image commands inside your view model -->
                        <TapGestureRecognizer Command="{Binding ChangeProfilePictureCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="📷"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- User Primary Identification Text Layout -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,0,0,5">
                <Label Text="{Binding UserName}" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                <Label Text="{Binding Email}" 
                       FontSize="14" 
                       HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
            </VerticalStackLayout>

            <!-- Account Structural Details Listing Card Section -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#252525}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource CardBgDark}}"
                    Padding="16, 8">
                <VerticalStackLayout>

                    <!-- Membership Status Metadata Details Field Row -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="📆" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Account Context" 
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" 
                               Text="{Binding MemberSince, StringFormat='Joined {0}'}" 
                               FontSize="13" 
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" 
                               VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#252525}" />

                    <!-- Role -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="🪪" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Role" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Role}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#252525}" />

                    <!-- Company -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="🏢" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Company" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding CompanyName}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#252525}" IsVisible="{Binding MealSubsidyLabel, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

                    <!-- Meal Subsidy -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12" IsVisible="{Binding MealSubsidyLabel, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="🍽️" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Meal Subsidy" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding MealSubsidyLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#252525}" />

                    <!-- Location -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="📍" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Delivery Location" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding LocationName}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#252525}" />

                    <!-- Delivery Floor — tappable to edit -->
                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditDeliveryFloorCommand}" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="🏢" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Delivery Floor" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding DeliveryFloor}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" VerticalOptions="Center"/>
                            <Label Text="›" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Settings & Help — moved here from the old flyout drawer, which no longer exists -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#252525}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource CardBgDark}}"
                    Padding="16, 4">
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToSettingsCommand}" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="⚙️" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Settings" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#252525}" />

                    <Grid ColumnDefinitions="*, Auto" Padding="0, 12">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToHelpCommand}" />
                        </Grid.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" Grid.Column="0" VerticalOptions="Center">
                            <Label Text="❓" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="Help &amp; Support" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" 
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="›" FontSize="18" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="Sign Out"
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="#C62828"
                    FontAttributes="Bold"
                    BorderColor="#C62828"
                    BorderWidth="1"
                    CornerRadius="10"
                    HeightRequest="46" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>