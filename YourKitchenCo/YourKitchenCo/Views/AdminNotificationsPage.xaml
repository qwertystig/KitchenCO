<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:YourKitchenCo.ViewModel"
             xmlns:views="clr-namespace:YourKitchenCo.Views"
             x:Class="YourKitchenCo.Views.AdminNotificationsPage"
             Title="Broadcast Notifications"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="Auto, *">
        <views:AdminNavStrip Grid.Row="0" ActiveRoute="adminnotifications" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Broadcast Composition Card -->
            <Border StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="16"
                    StrokeThickness="0">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Compose Broadcast" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

                    <!-- Audience Selector -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Target Audience" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" FontAttributes="Bold" />
                        <Picker ItemsSource="{Binding AudienceOptions}"
                                SelectedItem="{Binding SelectedAudience}"
                                Title="Select Target Group" />
                    </VerticalStackLayout>

                    <!-- Title Entry -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notification Title" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" FontAttributes="Bold" />
                        <Entry Text="{Binding Title}" Placeholder="e.g., Special Dinner Promo!" />
                    </VerticalStackLayout>

                    <!-- Body Editor -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Message Body" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" FontAttributes="Bold" />
                        <Editor Text="{Binding Message}" Placeholder="Write broadcast details here..." HeightRequest="90" AutoSize="Disabled" />
                    </VerticalStackLayout>

                    <!-- Send Action -->
                    <Button Text="Send Push Broadcast"
                            Command="{Binding SendNotificationCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                            TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Margin="0,8,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Notification History Header -->
            <Label Text="Sent History" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   Margin="0,10,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <!-- Log Stream -->
            <CollectionView ItemsSource="{Binding SentHistory}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                                Padding="14"
                                Margin="0,0,0,10"
                                StrokeThickness="0">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" Grid.Column="0" Grid.Row="0" />
                                <Label Text="{Binding TargetAudience}" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" FontAttributes="Bold" Grid.Column="1" Grid.Row="0" HorizontalOptions="End" />

                                <Label Text="{Binding Body}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Grid.ColumnSpan="2" Grid.Row="1" />

                                <Label Text="{Binding SentAt, StringFormat='{0:MMM dd, yyyy - hh:mm tt}'}" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Grid.Column="0" Grid.Row="2" />
                                <Label Text="{Binding RecipientCount, StringFormat='{0} recipients'}" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource MutedTextLight}, Dark={StaticResource MutedTextDark}}" Grid.Column="1" Grid.Row="2" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>