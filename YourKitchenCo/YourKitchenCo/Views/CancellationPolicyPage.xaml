<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourKitchenCo.Views.CancellationPolicyPage"
             Title="Cancellation Policy"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="Cancellation &amp; Holiday Policy" FontSize="20" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="9 AM Cutoff Rule" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Text="Your Kitchen Co. operates on a zero-food-waste, fresh-ingredient model. All corporate meal orders must be placed by 9:00 AM two business days before your scheduled delivery."
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="No Modifications or Refunds Past Cutoff" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Text="Once the 9:00 AM cutoff has passed, our kitchen immediately batches, preps, and allocates fresh ingredients. Orders cannot be cancelled, rescheduled, or refunded past this window."
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Public Holidays" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Text="Our kitchens are closed on all official South African public holidays, including observed holidays when one falls on a Sunday. These dates won't appear as available delivery options."
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Batch Drop-Off" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    <Label Text="All corporate meals arrive in insulated thermal carriers at your assigned drop-off point during your scheduled delivery window."
                           FontSize="13" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
