<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:YourKitchenCo.ViewModel"
             xmlns:models="clr-namespace:YourKitchenCo.Models"
             x:Class="YourKitchenCo.Views.OrderConfirmationPage"
             x:DataType="vm:OrderConfirmationViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Success badge -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" Margin="0,30,0,10">
                <Border StrokeThickness="2"
                        Stroke="#059669"
                        StrokeShape="RoundRectangle 40"
                        BackgroundColor="#1A059669"
                        WidthRequest="80"
                        HeightRequest="80"
                        HorizontalOptions="Center">
                    <Label Text="✓" FontSize="40" FontAttributes="Bold" TextColor="#059669" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Order Scheduled &amp; Paid!" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                <Label Text="{Binding FirstOrder.OrderNumber, StringFormat='Order #{0}'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            </VerticalStackLayout>

            <!-- Delivery info -->
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="DELIVERY DATE" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label Text="{Binding FirstOrder.DeliveryDate, StringFormat='{0:dddd, dd MMM yyyy}'}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Item snapshot -->
            <Border StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ItemCount, StringFormat='ITEMS IN THIS BATCH ({0})'}" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.5" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                    <CollectionView ItemsSource="{Binding Orders}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Order">
                                <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                    <Label Grid.Column="0" Text="{Binding ItemName}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                    <Label Grid.Column="1" Text="{Binding TotalAmount, StringFormat='R {0:F2}'}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Total Paid" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Grid.Column="1" Text="{Binding TotalPaid, StringFormat='R {0:F2}'}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Button Text="Track My Order"
                    Command="{Binding TrackOrderCommand}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48" />

            <Button Text="View Tax Invoice"
                    Command="{Binding ViewInvoiceCommand}"
                    BackgroundColor="Transparent"
                    BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    BorderWidth="1"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="48" />

            <Button Text="Done"
                    Command="{Binding DoneCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                    FontSize="13"
                    HeightRequest="40" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
