<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourKitchenCo.Views.AdminNavStrip"
             x:Name="Root">

    <VerticalStackLayout Spacing="0">

        <!-- Compact branding + live clock, matching what the old flyout header showed -->
        <Grid ColumnDefinitions="*, Auto" Padding="16,10,16,6">
            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                <Label Text="⚙️" FontSize="14" VerticalOptions="Center" />
                <Label Text="Central Command" FontSize="14" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 4" BackgroundColor="#1AF59E0B" Padding="6,2">
                    <Label Text="9AM Cutoff" FontSize="9" FontAttributes="Bold" TextColor="#B45309" />
                </Border>
                <Border StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                        Padding="8,3">
                    <Label x:Name="ClockLabel" Text="--:--:--" FontSize="11" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" Padding="16,10">

                <Button Text="Overview" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnOverviewClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="admindashboard">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Active Orders" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnActiveOrdersClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="adminactiveorders">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Companies" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnCompaniesClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="admincompanies">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Notifications" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnNotificationsClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="adminnotifications">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Menu Catalog" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnMenuCatalogClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="adminmenu">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Users" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnUserManagementClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="adminusers">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Reports" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnReportsClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="adminreports">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Text="Settings" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnSettingsClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActiveRoute, Source={x:Reference Root}}" Value="adminsettings">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            <Setter Property="BorderColor" Value="Transparent" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <!-- Switch to the customer-facing app as this admin (no re-login) — see OnCustomerViewClicked -->
                <Button Text="👤 Customer View" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnCustomerViewClicked"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                        TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />

                <Button Text="Logout" FontSize="12" FontAttributes="Bold" CornerRadius="18" HeightRequest="36" Padding="16,0"
                        Clicked="OnLogoutClicked" BackgroundColor="Transparent"
                        BorderColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" BorderWidth="1"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />

            </HorizontalStackLayout>
        </ScrollView>

        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}" />
    </VerticalStackLayout>
</ContentView>
