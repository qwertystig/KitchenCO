<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourKitchenCo.Views.Popups.AppActionSheetPage"
             BackgroundColor="#99000000"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid VerticalOptions="End">
        <Border x:Name="CardBorder"
                StrokeShape="RoundRectangle 22,22,0,0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                Padding="20,22"
                VerticalOptions="End"
                Opacity="0"
                TranslationY="40">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="20" Opacity="0.3" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">
                <Label x:Name="TitleLabel"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                <VerticalStackLayout x:Name="OptionStack" Spacing="8" />

                <Button x:Name="CancelButton"
                        HeightRequest="48"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        FontSize="15"
                        BackgroundColor="Transparent"
                        BorderWidth="1"
                        Margin="0,6,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
