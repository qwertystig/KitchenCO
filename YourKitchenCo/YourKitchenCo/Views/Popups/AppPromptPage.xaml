<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YourKitchenCo.Views.Popups.AppPromptPage"
             BackgroundColor="#99000000"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled">

    <Grid>
        <Border x:Name="CardBorder"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                Padding="26,24"
                MaximumWidthRequest="360"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="34"
                Opacity="0"
                Scale="0.92">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,8" Radius="24" Opacity="0.35" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="14">
                <Label x:Name="TitleLabel"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                <Label x:Name="MessageLabel"
                       FontSize="14"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        Padding="12,4"
                        BackgroundColor="Transparent">
                    <Entry x:Name="InputEntry"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                           BackgroundColor="Transparent" />
                </Border>

                <VerticalStackLayout x:Name="ButtonStack" Spacing="10" Margin="0,6,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
