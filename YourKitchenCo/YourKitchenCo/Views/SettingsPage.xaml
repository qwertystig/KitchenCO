<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:YourKitchenCo.Views"
             x:Class="YourKitchenCo.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Only visible when this shared page is reached via AdminShell —
             toggled in OnAppearing, since customers also use this same page
             and must never see admin navigation here. -->
        <views:AdminNavStrip x:Name="AdminNav" Grid.Row="0" ActiveRoute="adminsettings" IsVisible="False" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Signed in as -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="16, 12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Signed in as" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    <Label Text="{Binding AccountEmail}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Admin previewing the customer app — one tap back (hidden for everyone else) -->
            <Border IsVisible="{Binding IsAdminPreview}"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="16, 12">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="Admin preview" FontAttributes="Bold" FontSize="15" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="You're viewing the app as a customer" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Back to Admin" Command="{Binding ReturnToAdminCommand}"
                            FontSize="12" FontAttributes="Bold" HeightRequest="36" CornerRadius="8" Padding="12,0" VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                            TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                </Grid>
            </Border>

            <!-- Context Subtitle -->
            <Label Text="App Preferences" 
                   FontSize="14" 
                   FontAttributes="Bold" 
                   TextColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}" 
                   Margin="4,0,0,4"/>

            <!-- Notification Settings Card -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="16, 12">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="Push Notifications" 
                               FontAttributes="Bold" 
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="Alerts for order delivery updates" 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            IsToggled="{Binding IsNotificationsEnabled}" 
                            OnColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Dark Mode Settings Card -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="16, 12">
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="Dark Interface Mode" 
                               FontAttributes="Bold" 
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="Switch between light and dark display" 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" 
                            IsToggled="{Binding IsDarkModeEnabled}" 
                            OnColor="{AppThemeBinding Light={StaticResource BrandGold}, Dark={StaticResource BrandGoldDark}}"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- App Theme Settings Card -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="16, 14">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="App Theme"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                        <Label Text="Mediterranean Pantry or Ink &amp; Cream — applies across the whole app"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <!-- Mediterranean Pantry -->
                        <Border Grid.Row="0" Grid.Column="0"
                                StrokeShape="RoundRectangle 10" StrokeThickness="2" Stroke="Transparent"
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectBrandThemeCommand}" CommandParameter="MediterraneanPantry" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBrandTheme}" Value="MediterraneanPantry">
                                    <Setter Property="Stroke" Value="#D53220" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Padding="10" Spacing="6">
                                <BoxView HeightRequest="28" CornerRadius="6" Color="#D53220" />
                                <Label Text="Mediterranean Pantry" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ink & Cream (monochrome) — stored key is still "Current" -->
                        <Border Grid.Row="0" Grid.Column="1"
                                StrokeShape="RoundRectangle 10" StrokeThickness="2" Stroke="Transparent"
                                Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectBrandThemeCommand}" CommandParameter="Current" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedBrandTheme}" Value="Current">
                                    <Setter Property="Stroke" Value="#121212" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Padding="10" Spacing="6">
                                <BoxView HeightRequest="28" CornerRadius="6" Color="#121212" />
                                <Label Text="Ink &amp; Cream" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                            </VerticalStackLayout>
                        </Border>

                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Sign Out"
                    Command="{Binding SignOutCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                    FontAttributes="Bold"
                    BorderColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                    BorderWidth="1"
                    CornerRadius="10"
                    HeightRequest="46"
                    Margin="0,12,0,0" />

        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>