<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModel="clr-namespace:YourKitchenCo.ViewModel"
             xmlns:models="clr-namespace:YourKitchenCo.Models"
             x:Class="YourKitchenCo.Views.UserDashboardPage"
             x:DataType="viewModel:UserDashboardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}">

    <Grid>
    <ScrollView>
        <VerticalStackLayout>

            <!-- 1. Logo + Checkout Cart -->
            <Grid ColumnDefinitions="*, Auto" Padding="16,14,16,10" ColumnSpacing="10">
                <Image Grid.Column="0"
                       Source="{AppThemeBinding Light=yourkcolight.png, Dark=yourkcodark.png}"
                       HeightRequest="32"
                       HorizontalOptions="Start"
                       Aspect="AspectFit" />

                <Grid Grid.Column="1" WidthRequest="42" HeightRequest="42">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 21"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateToCartCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="🛒"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Border HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-4,-4,0"
                            Padding="5,1"
                            HeightRequest="18"
                            MinimumWidthRequest="18"
                            StrokeThickness="2"
                            Stroke="{AppThemeBinding Light={StaticResource PageBgLight}, Dark={StaticResource PageBgDark}}"
                            StrokeShape="RoundRectangle 9"
                            BackgroundColor="{AppThemeBinding Light=#DC2626, Dark=#F87171}"
                            InputTransparent="True">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding CartCount}" Value="0">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding CartCount}"
                               FontSize="9"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- 2. Search Bar -->
            <Border Margin="16,0,16,10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    HeightRequest="42">
                <SearchBar Placeholder="Search dishes, ingredients..."
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           Text="{Binding SearchText, Mode=TwoWay}"
                           SearchCommand="{Binding SearchCommand}"
                           BackgroundColor="Transparent"
                           CancelButtonColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}"
                           FontSize="14" />
            </Border>

            <!-- 3. Compact Date Display — tap to change delivery day -->
            <Border Margin="16,0,16,10"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                    Padding="14,10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeDeliveryDayCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                    <Label Grid.Column="0" Text="📅" FontSize="15" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                        <Label Text="Delivering" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                        <Label Text="{Binding SelectedDeliveryDateLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="Change ›" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Grid>
            </Border>

            <!-- 4. Menu Segment Toggle (Main Menu vs Cycling Menu) -->
            <Border Margin="16,0,16,14"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="{AppThemeBinding Light=#EFEFEF, Dark=#1E1E1E}"
                    Padding="4"
                    HeightRequest="48">
                <Grid ColumnDefinitions="*, *">
                    <Button Grid.Column="0"
                            Text="Main Menu"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="20"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                            Command="{Binding SwitchToMainCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CurrentMenu}" Value="Main">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1"
                            Text="Cycling Menu"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="20"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#AAAAAA}"
                            Command="{Binding SwitchToCyclingCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CurrentMenu}" Value="Weekly">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- 5. "Explore Our Menu" Section Label -->
            <Label Text="Explore Our Menu"
                   FontSize="20"
                   FontAttributes="Bold"
                   Margin="16,0,16,10"
                   TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

            <!-- 6. Category Slider — plain text, no icons, underline indicator on the active one -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,10">
                <HorizontalStackLayout Spacing="22" Padding="16,0">

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="All"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FilterCategoryCommand}" CommandParameter="" />
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ActiveCategory}" Value="">
                                    <Setter Property="FontAttributes" Value="Bold" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <BoxView HeightRequest="2.5" WidthRequest="20" CornerRadius="1.5"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                 IsVisible="False">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveCategory}" Value="">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="22" BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:CategoryChip">
                                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:UserDashboardViewModel}}, Path=FilterCategoryCommand}"
                                                                  CommandParameter="{Binding Name}" />
                                        </Label.GestureRecognizers>
                                        <Label.FontAttributes>
                                            <MultiBinding Converter="{StaticResource MultiValueEqualsConverter}">
                                                <Binding Path="Name" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type viewModel:UserDashboardViewModel}}" Path="ActiveCategory" />
                                            </MultiBinding>
                                        </Label.FontAttributes>
                                    </Label>
                                    <BoxView HeightRequest="2.5" WidthRequest="20" CornerRadius="1.5"
                                             BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <BoxView.IsVisible>
                                            <MultiBinding Converter="{StaticResource MultiValueEqualsConverter}">
                                                <Binding Path="Name" />
                                                <Binding Source="{RelativeSource AncestorType={x:Type viewModel:UserDashboardViewModel}}" Path="ActiveCategory" />
                                            </MultiBinding>
                                        </BoxView.IsVisible>
                                    </BoxView>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- 7. Ordering / Cutoff Message -->
            <Border Margin="16,0,16,14"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=#EFE9DC, Dark=#242426}"
                    Padding="12,10">
                <Label Text="Orders close at 9:00 AM, two business days before your delivery date."
                       FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
            </Border>

            <!-- 8. Category Sections — hero banner image per category, then that category's dishes -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding GroupedProducts}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CategorySection">
                        <VerticalStackLayout Spacing="0" Margin="0,0,0,20">

                            <!-- Category hero banner -->
                            <Border Margin="16,0,16,10"
                                    HeightRequest="110"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Grid>
                                    <Image Source="{Binding Category.ImageUrl}" Aspect="AspectFill" />
                                    <BoxView BackgroundColor="#8C000000" />
                                    <Label Text="{Binding Category.DisplayName}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           Margin="16,0,16,12"
                                           VerticalOptions="End" />
                                </Grid>
                            </Border>

                            <!-- Dishes in this category -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Products}" Spacing="10" Padding="16,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:Product">
                                        <Border StrokeThickness="1"
                                                StrokeShape="RoundRectangle 16"
                                                Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBgLight}, Dark={StaticResource CardBgDark}}"
                                                Padding="16">

                                            <Border.Shadow>
                                                <Shadow Brush="{AppThemeBinding Light=#12000000, Dark=#40000000}" Offset="0,2" Radius="4" Opacity="0.5" />
                                            </Border.Shadow>

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:UserDashboardViewModel}}, Path=NavigateToProductCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="14">

                                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                    <Label Text="{Binding Name}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />

                                                    <Label Text="{Binding Description}"
                                                           IsVisible="{Binding Description, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                           FontSize="13"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2"
                                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />

                                                    <Label IsVisible="{Binding HasIngredients}"
                                                           FontSize="12"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Ingredients: " FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                                <Span Text="{Binding Ingredients}" TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>

                                                    <FlexLayout IsVisible="{Binding HasDietaryTags}"
                                                                BindableLayout.ItemsSource="{Binding DietaryTags}"
                                                                Wrap="Wrap"
                                                                Direction="Row"
                                                                JustifyContent="Start"
                                                                Margin="0,2,0,0">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border StrokeThickness="1"
                                                                        StrokeShape="RoundRectangle 6"
                                                                        Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                                                        BackgroundColor="{AppThemeBinding Light=#EFE9DC, Dark=#242426}"
                                                                        Padding="8,3"
                                                                        Margin="0,0,6,6">
                                                                    <Label Text="{Binding .}"
                                                                           FontSize="11"
                                                                           FontAttributes="Bold"
                                                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryTextLight}, Dark={StaticResource PrimaryTextDark}}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End" VerticalOptions="Center" MinimumWidthRequest="78">
                                                    <Label Text="{Binding BasePrice, StringFormat='R {0:F2}'}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           HorizontalOptions="End"
                                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                                                    <Label Text="{Binding LargePrice, StringFormat='Large R {0:F2}'}"
                                                           IsVisible="{Binding LargePrice, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="End"
                                                           TextColor="{AppThemeBinding Light={StaticResource SecondaryTextLight}, Dark={StaticResource SecondaryTextDark}}"
                                                           Margin="0,0,0,4" />

                                                    <Button Text="+"
                                                            FontAttributes="Bold"
                                                            FontSize="20"
                                                            HeightRequest="40"
                                                            WidthRequest="40"
                                                            CornerRadius="20"
                                                            Padding="0"
                                                            HorizontalOptions="End"
                                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                            TextColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDarkText}}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModel:UserDashboardViewModel}}, Path=NavigateToProductCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

        <!-- Floating cart bar — only shown once something's in the basket, sits above the bottom nav -->
        <Border StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#66FFFFFF, Dark=#66000000}"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="{AppThemeBinding Light=#121212, Dark=#F7F2E8}"
                Padding="16,12"
                Margin="16,0,16,16"
                VerticalOptions="End"
                IsVisible="{Binding CartCount, Converter={StaticResource GreaterThanZeroConverter}}">
            <Border.Shadow>
                <Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.25" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding NavigateToCartCommand}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#121212}">
                    <Label Text="{Binding CartCount}" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#121212, Dark=#F7F2E8}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="{Binding CartTotal, StringFormat='R {0:F2}'}" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=White, Dark=#121212}" />
                    <Label Text="{Binding SelectedDeliveryDateLabel}" FontSize="10" FontAttributes="Bold" LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light=#A6FFFFFF, Dark=#A6121212}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                    <Label Text="Review Order" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=White, Dark=#121212}" />
                    <Label Text="→" FontSize="15" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=White, Dark=#121212}" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
